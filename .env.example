# Copy to .env or export these variables before starting the services.
# Never commit a real .env file or real API keys.
FJSP_DB_PASSWORD=change-this-password
FJSP_DB_HOST=localhost
FJSP_DB_PORT=5432
FJSP_DB_NAME=fjsp
FJSP_DB_USER=fjsp
FJSP_ALGORITHM_BASE_URL=http://localhost:8101
FJSP_API_BASE=http://localhost:8081/api/v1
# 前端静态目录（相对仓库根）：默认 Vue 版构建产物 web-vue/dist
# FJSP_WEB_DIR=web-vue/dist
FJSP_OPERATOR=demo-operator
# 演示脚本登录业务服务的账号（默认 admin 演示账号，仅本地演示；密码见 README「认证与账号」）
# FJSP_AUTH_USER=admin
# FJSP_AUTH_PASSWORD=Fj@123456
# 前端静态服务端口（默认 8082）
# FJSP_WEB_PORT=8082
# 前端完整入口地址（AGH fjsp-tools 生成甘特图链接用；start-demo.sh 会自动按上面的端口与 api 地址推导，一般无需设置）
# FJSP_WEB_BASE=http://127.0.0.1:8082/index.html?api=http://localhost:8081/api/v1
# 是否在 start-demo.sh 中启动 AGH 工作台（1=启动，0=跳过，默认 1）
# FJSP_START_AGH=1
# AgnesHub（MHS）地址，start-demo.sh 启动 AGH serve 时注入 AGNES_HUB_ORIGIN
# FJSP_AGH_HUB_ORIGIN=http://127.0.0.1:4180
# 是否随演示环境启动 MHS 虚拟机床 machine-m03（1=启动，0=跳过，默认 1）
# FJSP_START_MHS=1
# JWT 签名密钥（生产必改；不设置时业务服务使用仅用于本地开发的默认密钥）
# FJSP_JWT_SECRET=
# prod profile 下种子账号初始密码（缺失则业务服务启动失败；local/test 不需要）
# FJSP_SEED_ADMIN_PASSWORD=
# AGH/Agnes credentials are configured outside this repository.
# AGNES_API_KEY=
