# Copy to .env or export these variables before starting the services.
# Never commit a real .env file or real API keys.
FJSP_DB_PASSWORD=change-this-password
FJSP_DB_HOST=localhost
FJSP_DB_PORT=5432
FJSP_DB_NAME=fjsp
FJSP_DB_USER=fjsp
FJSP_ALGORITHM_BASE_URL=http://localhost:8101
FJSP_API_BASE=http://localhost:8081/api/v1
FJSP_OPERATOR=demo-operator
# JWT 签名密钥（生产必改；不设置时业务服务使用仅用于本地开发的默认密钥）
# FJSP_JWT_SECRET=
# AGH/Agnes credentials are configured outside this repository.
# AGNES_API_KEY=
