# runtime artifact written by driver/fjsp-agent.mts, read by fjsp-tools plugin
.agh-session-id

# local model credentials — never commit (use ~/.config/fjsp/agnes.env)
agnes.env

# MHS device runtime artifacts
mhs-devices/.venv/
mhs-devices/m03.pid

# agent-bff conversation -> AGH session mapping (runtime artifact)
agent-bff/.conversations.json

# agent-bff 审批裁决审计（JSONL，runtime artifact）
agent-bff/.approval-audit.jsonl

# agent-bff 审批记录轻量持久化（runtime artifact，任务 3.4）
agent-bff/.approvals.json

# agent-bff runtime deps & local models
agent-bff/node_modules/
agent-bff/models/

# agent-bff 受控工作流检查点（runtime artifact）
agent-bff/.web-workflows/
