# 生产环境变量模板：复制为 deploy/.env.prod 并填入真实值（.env.* 已被 gitignore，不会入库）。
# cp env.prod.example .env.prod

# 数据库（docker compose 创建 postgres 时使用；业务服务经内网连接，口令必须强随机）
FJSP_DB_NAME=fjsp
FJSP_DB_USER=fjsp
FJSP_DB_PASSWORD=change-this-to-a-long-random-password

# JWT 签名密钥（生产必改；建议 openssl rand -base64 48 生成）
FJSP_JWT_SECRET=change-this-jwt-secret

# prod profile 种子 admin 账号初始密码（缺失则业务服务启动失败）
FJSP_SEED_ADMIN_PASSWORD=change-this-admin-password

# 前端完整入口地址（twin 容器内 fjsp-tools 生成甘特图链接用）：
# 把 <服务器IP> 换成公网 IP 或域名
FJSP_WEB_BASE=http://<服务器IP>/index.html?api=http://<服务器IP>/api/v1

# fjsp-tools 登录业务系统的账号（默认 admin，密码即上面的种子密码，无需重复配置）
# FJSP_AUTH_USER=admin
