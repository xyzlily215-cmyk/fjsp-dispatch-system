# 隔离回归环境变量样例（任务 0.4）。复制为 .env.regression 后按需修改；
# .env.regression 已在 .gitignore 中忽略，真实口令绝不入库。
# 仅含回归专用变量（FJSP_REG_*），与演示用 .env 的 FJSP_DB_* 完全隔离。

# 回归 PostgreSQL（容器 fjsp-postgres-reg，deploy/docker-compose.regression.yml）
FJSP_REG_DB_PORT=15432
FJSP_REG_DB_NAME=fjsp_reg
FJSP_REG_DB_USER=fjsp_reg
# 必填：回归库口令。不设置时 scripts/run-regression.sh 会为本次运行生成一次性随机口令
# （回归库为一次性实例，脚本内对 compose 与业务服务使用同一口令，无需长期保存）。
FJSP_REG_DB_PASSWORD=change-this-regression-password

# 回归服务端口（演示环境为 business 8081 / algorithm 8101）
FJSP_REG_BUSINESS_PORT=18081
FJSP_REG_ALGORITHM_PORT=18101

# 回归登录账号：local profile 种子账号，与演示一致（见 README「认证与账号」）
# FJSP_REG_AUTH_USER=admin
# FJSP_REG_AUTH_PASSWORD=Fj@123456
